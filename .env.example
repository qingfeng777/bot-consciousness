# Copy to .env and fill in your cloud provider's configuration.
# The CLI reads environment variables; it does not execute or auto-load this file.
BOT_MODEL_BASE_URL=https://your-provider.example/v1
BOT_MODEL_NAME=replace-with-model-id
BOT_MODEL_API_KEY=
# Alternatively reference an existing provider key variable (do not set both):
# BOT_MODEL_API_KEY_ENV=OPENAI_API_KEY
BOT_MODEL_TIMEOUT=30
BOT_MODEL_MAX_TOKENS=2048
BOT_MODEL_MAX_CALLS=20
BOT_MODEL_MAX_CONCURRENCY=2
BOT_MODEL_JSON_MODE=true
BOT_MODEL_STREAM=false
BOT_MODEL_MODALITIES=text
BOT_MODEL_AUDIO_DATA_URL=true
BOT_MODEL_EXTRA_BODY='{}'
# Optional per-purpose model routing on the same provider endpoint:
# BOT_MODEL_PLAN=your-reasoning-model
# BOT_MODEL_PERCEPTION=your-multimodal-model
# BOT_MODEL_SUMMARIZE=your-text-model
# BOT_MODEL_LEARNING=your-reasoning-model
# Enable image/audio only when your configured model supports these wire formats.
# BOT_MODEL_MODALITIES=text,image,audio
# For providers requiring an explicit output modality / reasoning configuration:
# BOT_MODEL_EXTRA_BODY='{"modalities":["text"],"reasoning_effort":"none"}'

# Voice output: compatible POST /audio/speech returning PCM16 WAV.
# Explicit TTS endpoint and credentials; no implicit cross-provider key reuse.
BOT_TTS_BASE_URL=https://your-speech-provider.example/v1
BOT_TTS_MODEL=replace-with-tts-model
BOT_TTS_VOICE=replace-with-voice-id
BOT_TTS_API_KEY=
# Or reuse a key already injected in the process environment:
# BOT_TTS_API_KEY_ENV=BOT_MODEL_API_KEY
BOT_TTS_TIMEOUT=30
