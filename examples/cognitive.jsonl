{"at": 0, "op": "input", "id": "hello", "text": "小智，开始本机仿真"}
{"at": 1, "op": "observe", "eid": "e", "modality": "text", "content": "杯子在桌上"}
{"at": 2, "op": "observe", "eid": "e2", "modality": "image", "content": "labelled-image-001", "annotation": "杯子在架子上"}
{"at": 3, "op": "observe", "eid": "audio1", "modality": "audio", "content": "labelled-audio-001", "annotation": "请核对杯子位置"}
